# firestore-send-email 확장 파라미터
# SMTP_PASSWORD는 실제 비밀번호가 아니라 Secret Manager의 시크릿 버전 경로다
# (firebase functions:secrets:set 로 생성 — 아래 참고).
DATABASE=(default)
DATABASE_REGION=asia-northeast3
AUTH_TYPE=UsernamePassword
SMTP_CONNECTION_URI=smtps://tkdboykms0007%40gmail.com@smtp.gmail.com:465
SMTP_PASSWORD=projects/787224576231/secrets/FIRESTORE_SEND_EMAIL_SMTP_PASSWORD/versions/1
MAIL_COLLECTION=mail
DEFAULT_FROM=THE STEPPER <tkdboykms0007@gmail.com>
TTL_EXPIRE_TYPE=never
TTL_EXPIRE_VALUE=1
