rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /visitors/{doc=**} {
      allow read, write: if true;
    }
    match /stats/{doc=**} {
      allow read, write: if true;
    }
    match /movement_data/{doc=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email == 'tkdboykms0007@gmail.com';
    }
    match /schedules/{doc=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == 'tkdboykms0007@gmail.com';
    }
    match /locations/{doc=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == 'tkdboykms0007@gmail.com';
    }
    match /inquiries/{docId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && request.auth.token.email == 'tkdboykms0007@gmail.com';
    }
    match /users/{uid} {
      allow read: if request.auth != null
        && (request.auth.uid == uid
            || request.auth.token.email == 'tkdboykms0007@gmail.com');
      allow create, update: if request.auth != null && request.auth.uid == uid;
    }
    match /aiUsage/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null
        && request.auth.token.email == 'tkdboykms0007@gmail.com';
      allow write: if false;
    }
    match /ai_coaching/{docId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        request.auth.token.email == 'tkdboykms0007@gmail.com'
      );
      allow update: if request.auth != null && (
        request.auth.token.email == 'tkdboykms0007@gmail.com' ||
        (resource.data.userId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewed']))
      );
    }
    match /expertUsage/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /coaching_knowledge/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.email == 'tkdboykms0007@gmail.com';
    }
    match /ai_interview/{doc=**} {
      allow read: if request.auth != null
        && request.auth.token.email == 'tkdboykms0007@gmail.com';
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
        && request.auth.token.email == 'tkdboykms0007@gmail.com';
    }
    match /voice_drafts/{docId} {
      allow read, write: if request.auth != null
        && request.auth.token.email == 'tkdboykms0007@gmail.com';
    }
    // admin.html "⚖️ 품질 비교" 탭(항목 10) — 관리자가 브라우저에서 직접
    // Firestore 클라이언트 SDK로 읽고 쓴다 (서버 API 를 거치지 않음).
    match /comparison_questions/{docId} {
      allow read, write: if request.auth != null
        && request.auth.token.email == 'tkdboykms0007@gmail.com';
    }
    match /comparison_results/{docId} {
      allow read, write: if request.auth != null
        && request.auth.token.email == 'tkdboykms0007@gmail.com';
    }
    match /user_messages/{docId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewed']);
      allow create, delete: if false;
    }
    // quiz.html O/X 퀴즈 게임 — 로그인 없이 누구나 confirmed(승인된) 문제만
    // 읽는다. draft/discarded 는 관리자(admin.html "OX 퀴즈 관리" 탭, Admin
    // SDK 경유 manage-quiz.js)만 볼 수 있어야 하므로 공개 읽기에서 제외한다.
    match /quiz_questions/{docId} {
      allow read: if resource.data.status == 'confirmed';
      allow write: if request.auth != null
        && request.auth.token.email == 'tkdboykms0007@gmail.com';
    }
  }
}
